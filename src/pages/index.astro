							<div class="year-group">
								<h3 class="year-title">{yearGroup.year}</h3>
								{yearGroup.publications.map(pub => (
									<div class="experience">
										<div class="item">
											<h3 class="title">
												<a href={pub.link} target="_blank">{pub.title}</a>
											</h3>
											<h4 class="meta">{pub.authors}</h4>
											<div class="journal">{pub.journal}</div>
											<div class="time">{pub.month} {pub.year}</div>
										</div><!--//item-->
									</div><!--//experience-->
								))}
							</div><!--//year-group-->
						))}
					</div>
				</section><!--//section-->

				<section class="section experiences-section">
					<div class="section-header" data-section="presentations">
						<h2 class="section-title">
							<span class="icon-holder">06</span>
							Conference Presentations
						</h2>
						<span class="section-arrow">-</span>
					</div>
					<div id="presentations">
						{cv.presentations.map(item => (
							<div class="experience">
								<div class="item">
									<h3 class="title">{item.title}</h3>
									<h4 class="meta">{item.authors}</h4>
									<div class="journal">{item.type}, {item.venue}</div>
									<div class="time">{item.location}, {item.year}</div>
								</div><!--//item-->
							</div><!--//experience-->
						))}
					</div>
				</section><!--//section-->
			</div><!--//main-wrapper-->
			</div>

		<script>
			document.querySelectorAll('.section-header[data-section]').forEach((header) => {
				header.addEventListener('click', () => {
					const content = document.getElementById(header.dataset.section);
					const arrow = header.querySelector('.section-arrow');
					const isClosed = content.hidden;

					content.hidden = !isClosed;
					arrow.textContent = isClosed ? '-' : '+';
				});
			});
		</script>
	</body>
</html>
