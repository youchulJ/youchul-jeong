	<body>
		<div class="wrapper">
			<div class="sidebar-wrapper">
				<div class="profile-container">
					<h1 class="name">{cv.name}</h1>
					<h2 class="tagline">{cv.title}</h2>
				</div><!--//profile-container-->
				
				<div class="contact-container container-block">
