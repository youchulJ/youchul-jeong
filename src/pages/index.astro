	<body>
		<div class="background-system" aria-hidden="true">
			<svg viewBox="0 0 1440 1000" preserveAspectRatio="xMidYMid slice">
				<g class="orbit-track">
					<path class="orbit-path" d="M-120 930 C210 596 460 404 730 315 C976 233 1210 223 1560 37" />
				</g>
				<text class="coordinate-label" x="34" y="54">39.10° N</text>
				<text class="coordinate-label" x="1342" y="950">26.30° E</text>
			</svg>
		</div>
		<div class="wrapper">
			<div class="sidebar-wrapper">
				<div class="profile-container">
					<h1 class="name">{cv.name}</h1>
					<h2 class="tagline">{cv.title}</h2>
				</div><!--//profile-container-->
				
				<div class="contact-container container-block">
					<ul class="contact-list">
						{cv.email && (
							<li class="contact-item">
								<span class="icon">mail</span>
								<a href={`mailto:${cv.email}`} class="text">{cv.email}</a>
							</li>
						)}
						{cv.linkedin && (
							<li class="contact-item">
								<span class="icon">in</span>
								<a href={`https://www.linkedin.com/in/${cv.linkedin}`} target="_blank" rel="noopener noreferrer" class="text">LinkedIn</a>
							</li>
						)}
						{cv.github && (
							<li class="contact-item">
								<span class="icon">git</span>
								<a href={cv.github} target="_blank" rel="noopener noreferrer" class="text">GitHub</a>
							</li>
						)}
						{cv.researchgate && (
							<li class="contact-item">
								<span class="icon">pub</span>
								<a href={cv.researchgate} target="_blank" rel="noopener noreferrer" class="text">ResearchGate</a>
							</li>
						)}
						<li class="contact-item">
							<span class="icon">cv</span>
							<a href="/youchul-jeong-cv/Youchul%20Jeong%20CV.pdf" target="_blank" rel="noopener noreferrer" class="text">Download CV</a>
						</li>
					</ul>
				</div><!--//contact-container-->
				
				<div class="education-container container-block">
					<h2 class="container-block-title">Education</h2>
					{cv.education.map(item => (
						<div class="item">
							<h4 class="degree">{item.degree}</h4>
							<div class="meta">
								<span class="department">{item.department}</span>
								<span class="institution">{item.institution}</span>
							</div>
							<div class="time">{item.period}</div>
						</div>
					))}
				</div><!--//education-container-->
				
				<div class="skills-container container-block">
					<h2 class="container-block-title">Technical Skills</h2>
					<ul class="skills-list">
						{cv.skills.map(skill => (
							<li>{skill}</li>
						))}
					</ul>
				</div>
				
			</div><!--//sidebar-wrapper-->
			
			<div class="main-wrapper">
				<section class="section summary-section">
					<h2 class="section-title">
						<span class="icon-holder">01</span>
						Profile
					</h2>
					<div class="summary">
						<p>Youchul Jeong is a Ph.D. candidate in the Department of Marine Science at the University of the Aegean (<a href="https://mrsg.aegean.gr/" target="_blank" rel="noopener noreferrer">MRSG</a>) and an External Ph.D. candidate with the <a href="https://meo-lab.com/" target="_blank" rel="noopener noreferrer">MEO Lab</a> at the University of Bonn.</p>
						<p>His research aims to develop remote-sensing and machine-learning methods for detecting floating marine debris and other sea-surface features from satellite and UAV observations.</p>
					</div><!--//summary-->
				</section><!--//section-->
				
				<section class="section experiences-section">
					<div class="section-header" data-section="working">
						<h2 class="section-title">
							<span class="icon-holder">02</span>
							Research Appointments
						</h2>
						<span class="section-arrow">-</span>
					</div>
					<div id="working">
						{cv.workingExperience.map(item => (
							<div class="experience">
								<div class="item">
									<h3 class="title">{item.position}</h3>
									<h4 class="meta">{item.institution}</h4>
									<div class="time">{item.period}</div>
									<p class="description">{item.description}</p>
								</div><!--//item-->
							</div><!--//experience-->
						))}
					</div>
				</section><!--//section-->

				<section class="section experiences-section">
					<div class="section-header" data-section="research">
						<h2 class="section-title">
							<span class="icon-holder">03</span>
							Selected Research Experience
						</h2>
						<span class="section-arrow">-</span>
					</div>
					<div id="research">
						{cv.experience.map(item => (
							<div class="experience">
								<div class="item">
									<h3 class="title">{item.position}</h3>
									<h4 class="meta">{item.institution}</h4>
									<div class="time">{item.period}</div>
									<p class="description">{item.description}</p>
								</div><!--//item-->
							</div><!--//experience-->
						))}
					</div>
				</section><!--//section-->

				<section class="section experiences-section">
					<div class="section-header" data-section="publications">
						<h2 class="section-title">
							<span class="icon-holder">04</span>
							Peer-Reviewed Publications
						</h2>
						<span class="section-arrow">-</span>
					</div>
					<div id="publications">
						{groupedPublications.map(yearGroup => (
							<div class="year-group">
								<h3 class="year-title">{yearGroup.year}</h3>
								{yearGroup.publications.map(pub => (
									<div class="experience publication">
										<a class="publication-media" href={pub.link} target="_blank" rel="noopener noreferrer">
											<figure>
												<img src={pub.image} alt={pub.imageAlt} loading="lazy" />
												<figcaption>{pub.imageLabel}</figcaption>
											</figure>
										</a>
										<div class="item">
											<h3 class="title">
												<a href={pub.link} target="_blank" rel="noopener noreferrer">{pub.title}</a>
											</h3>
											<h4 class="meta">{pub.authors}</h4>
											<div class="journal">{pub.journal}</div>
											<div class="time">{pub.month} {pub.year}</div>
										</div><!--//item-->
									</div><!--//experience-->
								))}
							</div><!--//year-group-->
						))}
					</div>
				</section><!--//section-->
			</div><!--//main-wrapper-->
			</div>

		<script>
			import { gsap } from 'gsap';

			const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			if (!reduceMotion && window.innerWidth > 991) {
				const backgroundMotion = gsap.context(() => {
					gsap.to('.orbit-track', {
						x: 12,
						y: -8,
						duration: 32,
						repeat: -1,
						yoyo: true,
						ease: 'sine.inOut'
					});

					gsap.to('.orbit-path', {
						strokeDashoffset: -120,
						duration: 40,
						repeat: -1,
						ease: 'none'
					});
				}, document.querySelector('.background-system'));

				window.addEventListener('pagehide', () => backgroundMotion.revert(), { once: true });
			}

			document.querySelectorAll('.section-header[data-section]').forEach((header) => {
				header.addEventListener('click', () => {
					const content = document.getElementById(header.dataset.section);
					const arrow = header.querySelector('.section-arrow');
					const isClosed = content.hidden;

					content.hidden = !isClosed;
					arrow.textContent = isClosed ? '-' : '+';
				});
			});
		</script>
	</body>
</html>
