---
import cv from '../data/cv.json';
import SiteLayout from '../layouts/SiteLayout.astro';
const base = import.meta.env.BASE_URL;
const researchLinks: Record<string, string> = {
  'ReSe Application LLC': 'https://www.rese-apps.com/',
  'Won Joon Shim': 'https://scholar.google.com/citations?user=ca9JdS4AAAAJ&hl=en',
  'Daniel Schläpfer': 'https://scholar.google.com/citations?user=Bw2ZWS8AAAAJ&hl=en&oi=ao',
};
function descriptionParts(description: string) {
  return description.split(/(ReSe Application LLC|Won Joon Shim|Daniel Schläpfer)/g);
}
const months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
const papers = [...cv.publications].sort((a, b) => Number(b.year) - Number(a.year) || months.indexOf(b.month) - months.indexOf(a.month));
---
<SiteLayout active="home">
    <main>
      <section id="profile" aria-labelledby="profile-heading">
        <h1 id="profile-heading">Profile</h1>
        <p>Youchul Jeong is a Ph.D. candidate in Marine Science at the University of the Aegean and a member of the <a href="https://mrsg.aegean.gr/" target="_blank" rel="noopener noreferrer">Marine Remote Sensing Group (MRSG)</a>. He is also an External Ph.D. candidate with the <a href="https://meo-lab.com/" target="_blank" rel="noopener noreferrer">Machine Learning in Earth Observation (MEO) Lab</a> at the University of Bonn.</p>
        <p>His research focuses on detecting floating marine debris using satellite and UAV imagery, remote sensing, and machine learning.</p>
        <div class="contact" aria-label="Contact and professional profiles">
          <a href={`https://www.linkedin.com/in/${cv.linkedin}`} target="_blank" rel="noopener noreferrer">LinkedIn</a><span aria-hidden="true"> / </span>
          <a href={cv.github} target="_blank" rel="noopener noreferrer">GitHub</a><span aria-hidden="true"> / </span>
          <a href={cv.scholar} target="_blank" rel="noopener noreferrer">Google Scholar</a><span aria-hidden="true"> / </span>
          <a href={`mailto:${cv.email}`}>Email</a>
        </div>
      </section>
      <section id="papers" aria-labelledby="papers-heading">
        <div class="section-heading">
          <h2 id="papers-heading">Papers</h2>
          {papers.length > 2 && <button class="expand-button" type="button" aria-expanded="false" aria-controls="papers-entries" aria-label="Show all papers"><span aria-hidden="true">+</span></button>}
        </div>
          <ul class="entries" id="papers-entries">
            {papers.map(paper => (
              <li class="entry">
                <div class="date">{paper.year} {paper.month.slice(0, 3)}</div>
                <div>
                  <a class="paper-title" href={paper.link} target="_blank" rel="noopener noreferrer">{paper.title}</a>
                  <p class="meta">{paper.authors}</p>
                  <p class="venue"><em>{paper.journal}</em></p>
                </div>
              </li>
            ))}
          </ul>

      </section>
      <section id="teaching" aria-labelledby="teaching-heading">
        <div class="section-heading">
          <h2 id="teaching-heading">Teaching</h2>
          {cv.teaching.length > 2 && <button class="expand-button" type="button" aria-expanded="false" aria-controls="teaching-entries" aria-label="Show all teaching"><span aria-hidden="true">+</span></button>}
        </div>
          <ul class="entries" id="teaching-entries">
            {cv.teaching.map(item => (
              <li class="entry">
                <div class="date">{item.date}</div>
                <div><p class="entry-title">{item.title}</p><p class="venue">{item.institution} · {item.course}</p><p class="meta">{item.description}</p></div>
              </li>
            ))}
          </ul>

      </section>
      <section id="research" aria-labelledby="research-heading">
        <div class="section-heading">
          <h2 id="research-heading">Research Experience</h2>
          {cv.experience.length > 2 && <button class="expand-button" type="button" aria-expanded="false" aria-controls="research-entries" aria-label="Show all research experience"><span aria-hidden="true">+</span></button>}
        </div>
          <ul class="entries" id="research-entries">
            {cv.experience.map(item => (
              <li class="entry">
                <div class="date">{item.period}</div>
                <div>
                  <p class="entry-title">{'link' in item ? <a href={item.link} target="_blank" rel="noopener noreferrer">{item.position}</a> : item.position}</p>
                  {item.institution && <p>{item.institution}</p>}
                  <p class="meta">{descriptionParts(item.description).map(part => researchLinks[part] ? <a href={researchLinks[part]} target="_blank" rel="noopener noreferrer">{part}</a> : part)}</p>
                </div>
              </li>
            ))}
          </ul>

      </section>
      <section id="talks" aria-labelledby="talks-heading">
        <div class="section-heading">
          <h2 id="talks-heading">Conference Presentations</h2>
          {cv.presentations.length > 2 && <button class="expand-button" type="button" aria-expanded="false" aria-controls="talks-entries" aria-label="Show all conference presentations"><span aria-hidden="true">+</span></button>}
        </div>
          <ul class="entries" id="talks-entries">
            {cv.presentations.map(item => (
              <li class="entry">
                <div class="date">{item.year}</div>
                <div><p class="entry-title">{item.event}</p><p class="venue">{item.type} · {item.location}</p><p class="meta">{item.title}</p></div>
              </li>
            ))}
          </ul>

      </section>
    </main>
</SiteLayout>
<script>
  document.querySelectorAll<HTMLButtonElement>('.expand-button').forEach(button => {
    button.addEventListener('click', () => {
      const list = document.getElementById(button.getAttribute('aria-controls')!);
      if (!list) return;
      const expanded = button.getAttribute('aria-expanded') !== 'true';
      list.classList.toggle('expanded', expanded);
      button.setAttribute('aria-expanded', String(expanded));
      button.setAttribute('aria-label', `${expanded ? 'Show latest two' : 'Show all'} ${button.closest('section')?.querySelector('h2')?.textContent}`);
      button.querySelector('span')!.textContent = expanded ? '−' : '+';
    });
  });
</script>
