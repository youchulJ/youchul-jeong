						)}
						{cv.linkedin && (
							<li class="contact-item">
								<span class="icon">in</span>
								<a href={`https://www.linkedin.com/in/${cv.linkedin}`} target="_blank" rel="noopener noreferrer" class="text">LinkedIn</a>
							</li>
						)}
						{cv.github && (
							<li class="contact-item">
								<span class="icon">git</span>
								<a href={cv.github} target="_blank" rel="noopener noreferrer" class="text">GitHub</a>
							</li>
						)}
						{cv.researchgate && (
							<li class="contact-item">
								<span class="icon">pub</span>
								<a href={cv.researchgate} target="_blank" rel="noopener noreferrer" class="text">ResearchGate</a>
							</li>
						)}
						<li class="contact-item">
							<span class="icon">cv</span>
							<a href="/youchul-jeong-cv/Youchul%20Jeong%20CV.pdf" target="_blank" rel="noopener noreferrer" class="text">Download CV</a>
						</li>
					</ul>
				</div><!--//contact-container-->
				
				<div class="education-container container-block">
					<h2 class="container-block-title">Education</h2>
					{cv.education.map(item => (
						<div class="item">
							<h4 class="degree">{item.degree}</h4>
							<h5 class="meta">{item.institution}</h5>
							<div class="time">{item.period}</div>
						</div>
					))}
				</div><!--//education-container-->
				
				<div class="skills-container container-block">
					<h2 class="container-block-title">Technical Skills</h2>
					<ul class="skills-list">
						{cv.skills.map(skill => (
							<li>{skill}</li>
						))}
					</ul>
				</div>
				
				<div class="languages-container container-block">
					<h2 class="container-block-title">Languages</h2>
					<ul class="languages-list">
						{cv.languages.map(lang => (
							<li>
								<span class="language-name">{lang.split('(')[0].trim()}</span>
								<span class="language-level">{lang.match(/\(([^)]+)\)/)?.[1] || ''}</span>
							</li>
						))}
					</ul>
				</div>
			</div><!--//sidebar-wrapper-->
			
			<div class="main-wrapper">
				<section class="section summary-section">
					<h2 class="section-title">
						<span class="icon-holder">01</span>
						Profile
					</h2>
					<div class="summary">
						<p>Youchul Jeong is a Ph.D. candidate in the Department of Marine Science at the University of the Aegean (<a href="https://mrsg.aegean.gr/" target="_blank" rel="noopener noreferrer">Marine Remote Sensing Group - MRSG</a>) and an External PhD Candidate with the <a href="https://meo-lab.com/" target="_blank" rel="noopener noreferrer">Machine Learning in Earth Observation (MEO) Lab</a> at the University of Bonn. His research develops multi-scale detection frameworks for floating marine debris, integrating multi-sensor satellite data with high-resolution UAV imagery to provide actionable insights into plastic pollution. Working at the intersection of marine remote sensing, machine learning, and image processing, he aims to bridge complex orbital observations with practical environmental management and scalable ocean conservation solutions.</p>
					</div><!--//summary-->
				</section><!--//section-->
				
				<section class="section experiences-section">
					<div class="section-header" data-section="working">
						<h2 class="section-title">
							<span class="icon-holder">02</span>
							Working Experience
						</h2>
						<span class="section-arrow">▼</span>
					</div>
					<div id="working">
						{cv.workingExperience.map(item => (
							<div class="experience">
								<div class="item">
									<h3 class="title">{item.position}</h3>
									<h4 class="meta">{item.institution}</h4>
									<div class="time">{item.period}</div>
									<p class="description">{item.description}</p>
								</div><!--//item-->
							</div><!--//experience-->
						))}
					</div>
				</section><!--//section-->
				
				<section class="section experiences-section">
					<div class="section-header" data-section="research">
						<h2 class="section-title">
							<span class="icon-holder">03</span>
							Research Experience
						</h2>
						<span class="section-arrow">▼</span>
					</div>
					<div id="research">
						{cv.experience.map(item => (
							<div class="experience">
								<div class="item">
									<h3 class="title">{item.position}</h3>
									<h4 class="meta">{item.institution}</h4>
									<div class="time">{item.period}</div>
									<p class="description">{item.description}</p>
								</div><!--//item-->
							</div><!--//experience-->
						))}
					</div>
				</section><!--//section-->
				
				<section class="section experiences-section">
					<div class="section-header" data-section="teaching">
						<h2 class="section-title">
							<span class="icon-holder">04</span>
							Teaching Experience
						</h2>
						<span class="section-arrow">▼</span>
					</div>
					<div id="teaching">
						{cv.teaching.map(item => (
							<div class="teaching">
								<div class="item">
									<h3 class="title">{item.position}</h3>
									<h4 class="meta">{item.institution}</h4>
									<div class="time">{item.period}</div>
									<p class="description">{item.description}</p>
								</div><!--//item-->
							</div><!--//teaching-->
						))}
					</div>
				</section><!--//section-->
				
				<section class="section experiences-section">
					<div class="section-header" data-section="publications">
						<h2 class="section-title">
							<span class="icon-holder">05</span>
							Publications
						</h2>
						<span class="section-arrow">▼</span>
					</div>
					<div id="publications">
						{groupedPublications.map(yearGroup => (
							<div class="year-group">
								<h3 class="year-title">{yearGroup.year}</h3>
								{yearGroup.publications.map(pub => (
									<div class="experience">
										<div class="item">
											<h3 class="title">
												<a href={pub.link} target="_blank">{pub.title}</a>
											</h3>
											<h4 class="meta">{pub.authors}</h4>
											<div class="journal">{pub.journal}</div>
											<div class="time">{pub.month} {pub.year}</div>
										</div><!--//item-->
									</div><!--//experience-->
								))}
							</div><!--//year-group-->
						))}
					</div>
				</section><!--//section-->
			</div><!--//main-wrapper-->
		</div>
		
		<script>
			function toggleMainSection(sectionId) {
				const content = document.getElementById(sectionId);
				const header = content.previousElementSibling;
				const arrow = header.querySelector('.section-arrow');

				if (content.hidden) {
					content.hidden = false;
					arrow.textContent = '▼';
					header.classList.remove('collapsed');
				} else {
					content.hidden = true;
					arrow.textContent = '▶';
					header.classList.add('collapsed');
				}
			}

			document.querySelectorAll('.section-header[data-section]').forEach((header) => {
				header.addEventListener('click', () => {
					toggleMainSection(header.dataset.section);
				});
			});
		</script>
	</body>
</html>
